# Production Environment Template
# IMPORTANT: Never commit actual credentials. Use CI/CD secrets management.
# Copy this file to .env.production and fill in with real values locally only.

# Application
ENVIRONMENT=production
DEBUG=false
BASE_URL=https://vrenum.app
LOG_LEVEL=INFO

# Database - PostgreSQL (Neon)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Redis - Upstash
# Format: rediss://default:token@host:port
REDIS_URL=rediss://default:token@host:port
UPSTASH_REDIS_REST_URL=https://host.upstash.io
UPSTASH_REDIS_REST_TOKEN=token

# Security
SECRET_KEY=your-secret-key-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256

# Admin
ADMIN_EMAIL=admin@vrenum.app
ADMIN_PASSWORD=your-strong-password

# SMS Provider - TextVerified
TEXTVERIFIED_API_KEY=your-api-key
TEXTVERIFIED_EMAIL=your-email@example.com

# Payment - Paystack
PAYSTACK_PUBLIC_KEY=pk_live_xxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxx

# Email - Resend
RESEND_API_KEY=re_xxxxx
FROM_EMAIL_ADDRESS=support@vrenum.app
SUPPORT_EMAIL=support@vrenum.app
ADMIN_NOTIFY_EMAIL=vrenum.proton.me

# Monitoring - Sentry
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Push Notifications - OneSignal
ONESIGNAL_APP_ID=xxxxx
ONESIGNAL_API_KEY=os_v2_xxxxx

# OAuth - Google
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# Security - Turnstile (Cloudflare)
TURNSTILE_SITE_KEY=0x4AAAAAAA_xxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAA_xxxxx

# Pricing
PRICE_MARKUP=1.8
NGN_USD_RATE=1650.0

# CORS
CORS_ORIGINS=https://vrenum.app

# Server
WORKERS=2
PORT=8000

# Telegram Bot (SMS forwarding)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
