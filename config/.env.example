# =============================================================================
# Vrenum SMS — Environment Template
# =============================================================================
# Copy this file:  cp .env.example .env
# Then fill in your values.
# =============================================================================

# --- Core ---
ENVIRONMENT=development
BASE_URL=http://localhost:8000
SECRET_KEY=local-dev-secret-key-1234567890abcdefghijklmnop
JWT_SECRET_KEY=local-jwt-secret-key-67890abcdefghijklmnopqrst

# --- Database ---
DATABASE_URL=sqlite:///./data/namaskah.db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Admin ---
ADMIN_EMAIL=admin@vrenum.app
ADMIN_PASSWORD=YourAdminPassword

# --- Paystack ---
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SMS Providers (fill the ones you use) ---
TEXTVERIFIED_API_KEY=
TEXTVERIFIED_EMAIL=
TELNYX_API_KEY=
FIVESIM_API_KEY=
PVAPINS_API_KEY=
SMSPOOL_API_KEY=

# --- Email ---
# Option A (recommended): Resend — free up to 3,000 emails/month, no SMTP config needed
#   1. Sign up at https://resend.com
#   2. Add and verify your domain (vrenum.app)
#   3. Create an API key and paste it below
#   4. Set FROM_EMAIL_ADDRESS to an address on your verified domain
RESEND_API_KEY=
FROM_EMAIL_ADDRESS=hello@vrenum.app

# Option B: SMTP (Gmail, Zoho, Mailgun, etc.) — only used if RESEND_API_KEY is empty
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Support address shown in email footers and error pages
SUPPORT_EMAIL=support@vrenum.app

# Where system alerts go (revenue-zero, DB down, etc.)
# Defaults to ADMIN_EMAIL if not set
ADMIN_NOTIFY_EMAIL=

# --- Carrier Lookup ---
NUMVERIFY_API_KEY=

# --- Pricing ---
PRICE_MARKUP=1.8

# --- Exchange Rates ---
NGN_USD_RATE=1650.0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Crypto Wallets (optional) ---
BITCOIN_ADDRESS=
ETHEREUM_ADDRESS=
SOLANA_ADDRESS=
USDT_ADDRESS=

# --- Monitoring (optional) ---
SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project-id>

# --- Telegram Bot (SMS forwarding) ---
TELEGRAM_BOT_TOKEN=
